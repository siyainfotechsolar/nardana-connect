{
  "framework": "vite",
  "headers": [
    {
      "source": "/app-release.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"nardana-connect-v1.0.1.apk\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!app-release\\.apk|download\\.html|.*\\.(?:apk|png|jpg|jpeg|svg|css|js|ico)$).*)",
      "destination": "/index.html"
    }
  ]
}

