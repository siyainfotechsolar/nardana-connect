{
  "framework": "vite",
  "buildCommand": "npm --prefix apps/admin run build",
  "outputDirectory": "apps/admin/dist",
  "headers": [
    {
      "source": "/download.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/app-release.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"nardana-connect-v1.0.3.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!app-release\\.apk|download\\.html|.*\\.(?:apk|png|jpg|jpeg|svg|css|js|ico)$).*)",
      "destination": "/index.html"
    }
  ]
}

